{
  "expo": {
    "name": "Souleya",
    "slug": "souleya",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "souleya",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C2A35"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/19c7c3dc-862d-4e1d-8123-a23909ed3608"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.souleya.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C2A35"
      },
      "package": "com.souleya.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19c7c3dc-862d-4e1d-8123-a23909ed3608"
      }
    },
    "owner": "andreas_mutz",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
